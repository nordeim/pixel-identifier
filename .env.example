# --- Pixelco environment ---------------------------------------------------
# Copy to .env and fill in real values. Never commit .env.

# SQLite database file (default). For Postgres, use:
# DATABASE_URL="postgresql://user:password@localhost:5432/pixelco?schema=public"
DATABASE_URL="file:./db/pixelco.db"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-generate-a-32-plus-char-secret"
NEXTAUTH_URL="http://localhost:3000"
