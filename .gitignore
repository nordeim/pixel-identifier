# See https://help.github.com/articles/ignoring-files/ for more information.

# dependencies
node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# database (local sqlite)
/db/
*.db
*.db-journal

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# env files — never commit secrets
.env
.env.*
!.env.example

# deploy keys — the SSH push wrapper consumes keys via stdin/file/env only
*.key
ssh-key.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
