{
  "name": "pixelco",
  "version": "1.0.0",
  "private": true,
  "description": "Pixelco — identify anonymous website visitors by their real email address. A cookieless visitor-identification SaaS: marketing site, dashboard, tracking pixel, and identity-resolution pipeline.",
